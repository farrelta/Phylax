digraph workflow {
graph [rankdir=TB, bgcolor="#0b1017", pad="0.35", nodesep="0.38", ranksep="0.6", splines=polyline, outputorder=edgesfirst];
node [fontname="DejaVu Sans", fontsize=12, fontcolor="#e6e8ec", shape=box, style="rounded,filled", penwidth=1.1, margin="0.18,0.12"];
edge [fontname="DejaVu Sans", fontsize=10, fontcolor="#c2cbd8", color="#8392a5", arrowsize=0.7, penwidth=1.1];
"event" [label="Stored conn / Modbus event and\ncurrent configured policy", tooltip="Stored conn / Modbus event and current configured policy", shape=cylinder, fillcolor="#17202a", color="#738397"];
"fields" [label="For each rule: required\nevidence and policy section\navailable?", tooltip="For each rule: required evidence and policy section available?", shape=diamond, fillcolor="#292419", color="#b39461"];
"diagnostic" [label="Record cannot-evaluate\ndiagnostic; do not fabricate a\nviolation", tooltip="Record cannot-evaluate diagnostic; do not fabricate a violation", shape=box, fillcolor="#292217", color="#c4a071"];
"rules" [label="Evaluate configured rules\nindependently", tooltip="Evaluate configured rules independently", shape=box, fillcolor="#14202f", color="#7197bd"];
"writer" [label="Unauthorized Modbus writer?", tooltip="Unauthorized Modbus writer?", shape=diamond, fillcolor="#292419", color="#b39461"];
"peer" [label="Protected-destination\ncommunication violates\nallowlist?", tooltip="Protected-destination communication violates allowlist?", shape=diamond, fillcolor="#292419", color="#b39461"];
"window" [label="Prohibited write outside\napproved maintenance window?", tooltip="Prohibited write outside approved maintenance window?", shape=diamond, fillcolor="#292419", color="#b39461"];
"violate" [label="Create/update rule + event\nalert with policy evidence", tooltip="Create/update rule + event alert with policy evidence", shape=cylinder, fillcolor="#17202a", color="#738397"];
"normal" [label="No rule violation; observation\nstays available", tooltip="No rule violation; observation stays available", shape=cylinder, fillcolor="#17202a", color="#738397"];
"repolicy" [label="New policy version / repeat\nimport \u2192 reevaluate stored\nevents", tooltip="New policy version / repeat import \u2192 reevaluate stored events", shape=box, fillcolor="#14202f", color="#7197bd"];
"cleared" [label="Violation cleared \u2192 resolved\nhistory; exclude from active\ncount", tooltip="Violation cleared \u2192 resolved history; exclude from active count", shape=box, fillcolor="#15271f", color="#7eaa90"];
"networkscore" [label="Network / management urgency v1\nfrom severity, relevant\ncriticality and protected\ndestination", tooltip="Network / management urgency v1 from severity, relevant criticality and protected destination", shape=box, fillcolor="#14202f", color="#7197bd"];
"exposure" [label="Exposure alerts already carry\nvulnerability v2 urgency", tooltip="Exposure alerts already carry vulnerability v2 urgency", shape=cylinder, fillcolor="#17202a", color="#738397"];
"endpoint" [label="Endpoint management alerts\ncarry their evidence", tooltip="Endpoint management alerts carry their evidence", shape=cylinder, fillcolor="#17202a", color="#738397"];
"triage" [label="Filter unified Triage by\ncategory, urgency, review state\nand text", tooltip="Filter unified Triage by category, urgency, review state and text", shape=box, fillcolor="#292217", color="#c4a071"];
"inspect" [label="Inspect asset, original event,\npolicy, score factors and\nprocess context", tooltip="Inspect asset, original event, policy, score factors and process context", shape=box, fillcolor="#292217", color="#c4a071"];
"ack" [label="Acknowledge reviewed alert;\nretain filters and evidence", tooltip="Acknowledge reviewed alert; retain filters and evidence", shape=box, fillcolor="#14202f", color="#7197bd"];
"follow" [label="Supply identity evidence,\nchange approved policy or\nreview a plan", tooltip="Supply identity evidence, change approved policy or review a plan", shape=box, fillcolor="#292217", color="#c4a071"];
"event" -> "fields" [label="", style=solid];
"fields" -> "diagnostic" [label="No", style=solid];
"fields" -> "rules" [label="Yes", style=solid];
"rules" -> "writer" [label="", style=solid];
"rules" -> "peer" [label="", style=solid];
"rules" -> "window" [label="", style=solid];
"writer" -> "violate" [label="Yes", style=solid];
"peer" -> "violate" [label="Yes", style=solid];
"window" -> "violate" [label="Yes", style=solid];
"writer" -> "normal" [label="No", style=solid];
"peer" -> "normal" [label="No", style=solid];
"window" -> "normal" [label="No", style=solid];
"repolicy" -> "fields" [label="", style=solid];
"repolicy" -> "cleared" [label="No longer violates", style=solid];
"violate" -> "networkscore" [label="", style=solid];
"endpoint" -> "networkscore" [label="", style=solid];
"networkscore" -> "triage" [label="", style=solid];
"exposure" -> "triage" [label="", style=solid];
"triage" -> "inspect" [label="", style=solid];
"inspect" -> "ack" [label="", style=solid];
"inspect" -> "follow" [label="", style=solid];
"follow" -> "repolicy" [label="Policy review", style=dashed];
}