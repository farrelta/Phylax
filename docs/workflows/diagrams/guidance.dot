digraph workflow {
graph [rankdir=TB, bgcolor="#0b1017", pad="0.35", nodesep="0.38", ranksep="0.6", splines=polyline, outputorder=edgesfirst];
node [fontname="DejaVu Sans", fontsize=12, fontcolor="#e6e8ec", shape=box, style="rounded,filled", penwidth=1.1, margin="0.18,0.12"];
edge [fontname="DejaVu Sans", fontsize=10, fontcolor="#c2cbd8", color="#8392a5", arrowsize=0.7, penwidth=1.1];
"request" [label="Operator requests plan for a\nselected finding", tooltip="Operator requests plan for a selected finding", shape=box, fillcolor="#292217", color="#c4a071"];
"job" [label="Bounded process-local\nbackground job with progress", tooltip="Bounded process-local background job with progress", shape=box, fillcolor="#14202f", color="#7197bd"];
"eligible" [label="Configured provider AND trusted\npublic snapshot AND\nnon-synthetic record?", tooltip="Configured provider AND trusted public snapshot AND non-synthetic record?", shape=diamond, fillcolor="#292419", color="#b39461"];
"localreason" [label="Explain disabled / synthetic /\nuntrusted-source path; no\nhosted request", tooltip="Explain disabled / synthetic / untrusted-source path; no hosted request", shape=cylinder, fillcolor="#17202a", color="#738397"];
"public" [label="Allowlist public CVE/advisory\nfields and supplied reference\nURLs", tooltip="Allowlist public CVE/advisory fields and supplied reference URLs", shape=cylinder, fillcolor="#17202a", color="#738397"];
"remote" [label="Hosted model receives public\nadvisory fields only", tooltip="Hosted model receives public advisory fields only", shape=box, fillcolor="#14202f", color="#7197bd"];
"validate" [label="Response shape, citations,\ntimeout / failure and\ncommand-syntax checks pass?", tooltip="Response shape, citations, timeout / failure and command-syntax checks pass?", shape=diamond, fillcolor="#292419", color="#b39461"];
"good" [label="AI-generated, unverified\npublic-guidance supplement", tooltip="AI-generated, unverified public-guidance supplement", shape=cylinder, fillcolor="#17202a", color="#738397"];
"failure" [label="Record explicit provider /\nvalidation failure", tooltip="Record explicit provider / validation failure", shape=box, fillcolor="#2b1c23", color="#bd8591"];
"current" [label="Finding unchanged during\ngeneration?", tooltip="Finding unchanged during generation?", shape=diamond, fillcolor="#292419", color="#b39461"];
"retry" [label="Reject stale result; operator\nreviews current finding and\nretries", tooltip="Reject stale result; operator reviews current finding and retries", shape=box, fillcolor="#292217", color="#c4a071"];
"existing" [label="Fallback reason and previous\nhosted plan exists?", tooltip="Fallback reason and previous hosted plan exists?", shape=diamond, fillcolor="#292419", color="#b39461"];
"keep" [label="Keep previous hosted plan;\nrecord failure reason", tooltip="Keep previous hosted plan; record failure reason", shape=box, fillcolor="#15271f", color="#7eaa90"];
"compose" [label="Compose deterministic local\nplan; attach valid public AI\nsupplement if available", tooltip="Compose deterministic local plan; attach valid public AI supplement if available", shape=box, fillcolor="#14202f", color="#7197bd"];
"save" [label="Store plan, actual model,\ntimestamps, supplied / cited\nURLs and provenance", tooltip="Store plan, actual model, timestamps, supplied / cited URLs and provenance", shape=cylinder, fillcolor="#17202a", color="#738397"];
"archive" [label="Regeneration archives old\ncontents and clears prior\nreview / verification", tooltip="Regeneration archives old contents and clears prior review / verification", shape=box, fillcolor="#292217", color="#c4a071"];
"review" [label="Continue to human lifecycle;\nfinding severity,\napplicability, urgency and\nacknowledgement unchanged", tooltip="Continue to human lifecycle; finding severity, applicability, urgency and acknowledgement unchanged", shape=box, fillcolor="#15271f", color="#7eaa90"];
"private" [label="Inventory, IPs, events,\npolicies, local risk and\nprocess context stay local", tooltip="Inventory, IPs, events, policies, local risk and process context stay local", shape=cylinder, fillcolor="#17202a", color="#738397"];
"request" -> "job" [label="", style=solid];
"job" -> "eligible" [label="", style=solid];
"eligible" -> "localreason" [label="No", style=solid];
"eligible" -> "public" [label="Yes", style=solid];
"private" -> "compose" [label="Local evidence only", style=solid];
"public" -> "remote" [label="", style=solid];
"remote" -> "validate" [label="", style=solid];
"validate" -> "good" [label="Yes", style=solid];
"validate" -> "failure" [label="No", style=solid];
"good" -> "current" [label="", style=solid];
"localreason" -> "current" [label="", style=solid];
"failure" -> "current" [label="", style=solid];
"current" -> "retry" [label="No", style=solid];
"current" -> "existing" [label="Yes", style=solid];
"existing" -> "keep" [label="Yes", style=solid];
"existing" -> "compose" [label="No", style=solid];
"compose" -> "save" [label="", style=solid];
"save" -> "archive" [label="Replacing prior plan", style=solid];
"save" -> "review" [label="New plan", style=solid];
"archive" -> "review" [label="", style=solid];
"keep" -> "review" [label="", style=solid];
}