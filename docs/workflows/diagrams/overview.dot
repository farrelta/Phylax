digraph workflow {
graph [rankdir=TB, bgcolor="#0b1017", pad="0.35", nodesep="0.38", ranksep="0.6", splines=polyline, outputorder=edgesfirst];
node [fontname="DejaVu Sans", fontsize=12, fontcolor="#e6e8ec", shape=box, style="rounded,filled", penwidth=1.1, margin="0.18,0.12"];
edge [fontname="DejaVu Sans", fontsize=10, fontcolor="#c2cbd8", color="#8392a5", arrowsize=0.7, penwidth=1.1];
"start" [label="Operator opens local Phylax", tooltip="Operator opens local Phylax", shape=box, fillcolor="#14202f", color="#7197bd"];
"setup" [label="Configure sources, policies,\nsubnets and optional collectors", tooltip="Configure sources, policies, subnets and optional collectors", shape=box, fillcolor="#14202f", color="#7197bd"];
"assets" [label="Manual or CSV inventory; owner\nand process context", tooltip="Manual or CSV inventory; owner and process context", shape=cylinder, fillcolor="#17202a", color="#738397"];
"passive" [label="Imported Zeek logs, PCAP\nresults or finalized-log\nwatcher", tooltip="Imported Zeek logs, PCAP results or finalized-log watcher", shape=cylinder, fillcolor="#17202a", color="#738397"];
"active" [label="Individually permitted\nsupporting IT discovery", tooltip="Individually permitted supporting IT discovery", shape=box, fillcolor="#14202f", color="#7197bd"];
"intel" [label="Public feeds, selected CSAF,\nCVE refresh or offline fixture", tooltip="Public feeds, selected CSAF, CVE refresh or offline fixture", shape=cylinder, fillcolor="#17202a", color="#738397"];
"store" [label="Local SQLite: identity,\nprovenance, observations,\nhealth and history", tooltip="Local SQLite: identity, provenance, observations, health and history", shape=cylinder, fillcolor="#17202a", color="#738397"];
"management" [label="Management and identity reviews", tooltip="Management and identity reviews", shape=box, fillcolor="#292217", color="#c4a071"];
"software" [label="Software mapping and\nverification", tooltip="Software mapping and verification", shape=box, fillcolor="#292217", color="#c4a071"];
"correlate" [label="Conservative asset / component\napplicability", tooltip="Conservative asset / component applicability", shape=box, fillcolor="#14202f", color="#7197bd"];
"detect" [label="Configured passive policy rules", tooltip="Configured passive policy rules", shape=box, fillcolor="#14202f", color="#7197bd"];
"priority" [label="Separate severity, confidence\nand deterministic urgency", tooltip="Separate severity, confidence and deterministic urgency", shape=box, fillcolor="#15271f", color="#7eaa90"];
"triage" [label="Unified Triage: evidence,\ncontext and acknowledgement", tooltip="Unified Triage: evidence, context and acknowledgement", shape=box, fillcolor="#292217", color="#c4a071"];
"topology" [label="Passive topology investigation\nand original evidence", tooltip="Passive topology investigation and original evidence", shape=box, fillcolor="#292217", color="#c4a071"];
"plan" [label="Operator requests advisory\nguidance and remediation plan", tooltip="Operator requests advisory guidance and remediation plan", shape=box, fillcolor="#292217", color="#c4a071"];
"human" [label="Human reviews, approves and\nrecords external work", tooltip="Human reviews, approves and records external work", shape=box, fillcolor="#292217", color="#c4a071"];
"reassess" [label="Update inventory / evidence;\nreassess findings", tooltip="Update inventory / evidence; reassess findings", shape=box, fillcolor="#14202f", color="#7197bd"];
"report" [label="Export JSON, CSV, Markdown or\ninventory CSV", tooltip="Export JSON, CSV, Markdown or inventory CSV", shape=box, fillcolor="#15271f", color="#7eaa90"];
"offline" [label="Stored inventory, evidence,\nreplay and reporting remain\nlocal", tooltip="Stored inventory, evidence, replay and reporting remain local", shape=cylinder, fillcolor="#17202a", color="#738397"];
"start" -> "setup" [label="", style=solid];
"setup" -> "assets" [label="", style=solid];
"setup" -> "passive" [label="", style=solid];
"setup" -> "active" [label="", style=solid];
"setup" -> "intel" [label="", style=solid];
"assets" -> "store" [label="", style=solid];
"passive" -> "store" [label="", style=solid];
"active" -> "store" [label="Probe evidence stays distinct", style=solid];
"intel" -> "store" [label="", style=solid];
"store" -> "management" [label="", style=solid];
"store" -> "software" [label="", style=solid];
"store" -> "correlate" [label="", style=solid];
"passive" -> "detect" [label="", style=solid];
"software" -> "correlate" [label="", style=solid];
"correlate" -> "priority" [label="", style=solid];
"detect" -> "priority" [label="", style=solid];
"management" -> "priority" [label="", style=solid];
"priority" -> "triage" [label="", style=solid];
"store" -> "topology" [label="", style=solid];
"topology" -> "triage" [label="Investigate evidence", style=solid];
"triage" -> "plan" [label="", style=solid];
"plan" -> "human" [label="", style=solid];
"human" -> "reassess" [label="No equipment action by Phylax", style=solid];
"reassess" -> "store" [label="", style=solid];
"triage" -> "report" [label="", style=solid];
"human" -> "report" [label="", style=solid];
"store" -> "offline" [label="", style=solid];
}