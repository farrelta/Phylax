digraph workflow {
graph [rankdir=LR, bgcolor="#0b1017", pad="0.35", nodesep="0.38", ranksep="0.6", splines=polyline, outputorder=edgesfirst];
node [fontname="DejaVu Sans", fontsize=12, fontcolor="#e6e8ec", shape=box, style="rounded,filled", penwidth=1.1, margin="0.18,0.12"];
edge [fontname="DejaVu Sans", fontsize=10, fontcolor="#c2cbd8", color="#8392a5", arrowsize=0.7, penwidth=1.1];
"start" [label="Generate new plan / regenerate\nexisting plan", tooltip="Generate new plan / regenerate existing plan", shape=box, fillcolor="#14202f", color="#7197bd"];
"recommended" [label="Recommended", tooltip="Recommended", shape=box, fillcolor="#292217", color="#c4a071"];
"underreview" [label="Under Review", tooltip="Under Review", shape=box, fillcolor="#292217", color="#c4a071"];
"approved" [label="Approved", tooltip="Approved", shape=box, fillcolor="#292217", color="#c4a071"];
"implemented" [label="Implemented", tooltip="Implemented", shape=box, fillcolor="#292217", color="#c4a071"];
"rejected" [label="Rejected", tooltip="Rejected", shape=box, fillcolor="#292217", color="#c4a071"];
"deferred" [label="Deferred", tooltip="Deferred", shape=box, fillcolor="#292217", color="#c4a071"];
"needsmoreevidence" [label="Needs More Evidence", tooltip="Needs More Evidence", shape=box, fillcolor="#292217", color="#c4a071"];
"verified" [label="Verified", tooltip="Verified", shape=box, fillcolor="#15271f", color="#7eaa90"];
"evidence" [label="Supporting finding evidence /\npriority changes \u2192 archive\nsnapshot and clear review", tooltip="Supporting finding evidence / priority changes \u2192 archive snapshot and clear review", shape=cylinder, fillcolor="#17202a", color="#738397"];
"external" [label="Any infrastructure change is\nperformed separately by\nauthorized people", tooltip="Any infrastructure change is performed separately by authorized people", shape=cylinder, fillcolor="#17202a", color="#738397"];
"start" -> "recommended" [label="New or replacement plan", style=solid];
"recommended" -> "underreview" [label="", style=solid];
"recommended" -> "rejected" [label="", style=solid];
"recommended" -> "deferred" [label="", style=solid];
"recommended" -> "needsmoreevidence" [label="", style=solid];
"underreview" -> "recommended" [label="", style=solid];
"underreview" -> "approved" [label="Reviewer required", style=solid];
"underreview" -> "rejected" [label="", style=solid];
"underreview" -> "deferred" [label="", style=solid];
"underreview" -> "needsmoreevidence" [label="", style=solid];
"approved" -> "underreview" [label="", style=solid];
"approved" -> "implemented" [label="Record external implementation", style=solid];
"approved" -> "rejected" [label="", style=solid];
"approved" -> "deferred" [label="", style=solid];
"implemented" -> "underreview" [label="", style=solid];
"implemented" -> "verified" [label="Verification evidence required", style=solid];
"implemented" -> "deferred" [label="", style=solid];
"rejected" -> "recommended" [label="", style=solid];
"rejected" -> "underreview" [label="", style=solid];
"deferred" -> "recommended" [label="", style=solid];
"deferred" -> "underreview" [label="", style=solid];
"needsmoreevidence" -> "recommended" [label="", style=solid];
"needsmoreevidence" -> "underreview" [label="", style=solid];
"verified" -> "underreview" [label="", style=solid];
"evidence" -> "needsmoreevidence" [label="Re-review required", style=solid];
"approved" -> "external" [label="Guidance only", style=dashed];
}