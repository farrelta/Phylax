digraph workflow {
graph [rankdir=TB, bgcolor="#0b1017", pad="0.35", nodesep="0.38", ranksep="0.6", splines=polyline, outputorder=edgesfirst];
node [fontname="DejaVu Sans", fontsize=12, fontcolor="#e6e8ec", shape=box, style="rounded,filled", penwidth=1.1, margin="0.18,0.12"];
edge [fontname="DejaVu Sans", fontsize=10, fontcolor="#c2cbd8", color="#8392a5", arrowsize=0.7, penwidth=1.1];
"entry" [label="Choose passive input", tooltip="Choose passive input", shape=diamond, fillcolor="#292419", color="#b39461"];
"file" [label="CLI or dashboard: finalized\nZeek log", tooltip="CLI or dashboard: finalized Zeek log", shape=cylinder, fillcolor="#17202a", color="#738397"];
"pcap" [label="Offline PCAP: local Zeek or\ninstalled network-disabled\nDocker image", tooltip="Offline PCAP: local Zeek or installed network-disabled Docker image", shape=box, fillcolor="#14202f", color="#7197bd"];
"tools" [label="Tool / capture available and\nvalid?", tooltip="Tool / capture available and valid?", shape=diamond, fillcolor="#292419", color="#b39461"];
"toolerror" [label="Show diagnostic; retain stored\nworkflows", tooltip="Show diagnostic; retain stored workflows", shape=box, fillcolor="#2b1c23", color="#bd8591"];
"logs" [label="Zeek output logs with capture\nreference", tooltip="Zeek output logs with capture reference", shape=cylinder, fillcolor="#17202a", color="#738397"];
"watch" [label="Watcher polls finalized conn /\nmodbus / dhcp / software logs", tooltip="Watcher polls finalized conn / modbus / dhcp / software logs", shape=box, fillcolor="#14202f", color="#7197bd"];
"stable" [label="Supported, bounded, non-symlink\nfile stable across two polls?", tooltip="Supported, bounded, non-symlink file stable across two polls?", shape=diamond, fillcolor="#292419", color="#b39461"];
"wait" [label="Wait for stability or report\nskipped / unsupported file", tooltip="Wait for stability or report skipped / unsupported file", shape=box, fillcolor="#292217", color="#c4a071"];
"snapshot" [label="Snapshot and hash stable\ncontent", tooltip="Snapshot and hash stable content", shape=box, fillcolor="#14202f", color="#7197bd"];
"new" [label="Content differs from saved\noutcome?", tooltip="Content differs from saved outcome?", shape=diamond, fillcolor="#292419", color="#b39461"];
"skip" [label="Skip unchanged content; retain\nprior success or failure\ndiagnostic", tooltip="Skip unchanged content; retain prior success or failure diagnostic", shape=cylinder, fillcolor="#17202a", color="#738397"];
"parse" [label="Use dedicated JSON Lines / TSV\nparser for each log kind", tooltip="Use dedicated JSON Lines / TSV parser for each log kind", shape=box, fillcolor="#14202f", color="#7197bd"];
"valid" [label="Whole file remains valid and\nunchanged during import?", tooltip="Whole file remains valid and unchanged during import?", shape=diamond, fillcolor="#292419", color="#b39461"];
"rollback" [label="Roll back this file; record\nfailure; changed content may\nretry", tooltip="Roll back this file; record failure; changed content may retry", shape=box, fillcolor="#2b1c23", color="#bd8591"];
"commit" [label="Atomic deduplicated records;\nobserved time distinct from\ningestion time", tooltip="Atomic deduplicated records; observed time distinct from ingestion time", shape=cylinder, fillcolor="#17202a", color="#738397"];
"dispatch" [label="Connections / Modbus \u2192 events\nand rules; DHCP \u2192 identity;\nsoftware \u2192 components", tooltip="Connections / Modbus \u2192 events and rules; DHCP \u2192 identity; software \u2192 components", shape=box, fillcolor="#14202f", color="#7197bd"];
"health" [label="Update collector health, change\nhistory and evidence references", tooltip="Update collector health, change history and evidence references", shape=box, fillcolor="#15271f", color="#7eaa90"];
"entry" -> "file" [label="Import log", style=solid];
"entry" -> "pcap" [label="Replay capture", style=solid];
"entry" -> "watch" [label="Watch folder", style=solid];
"pcap" -> "tools" [label="", style=solid];
"tools" -> "toolerror" [label="No", style=solid];
"tools" -> "logs" [label="Yes", style=solid];
"logs" -> "parse" [label="", style=solid];
"file" -> "parse" [label="", style=solid];
"watch" -> "stable" [label="", style=solid];
"stable" -> "wait" [label="No", style=solid];
"wait" -> "watch" [label="Later poll", style=solid];
"stable" -> "snapshot" [label="Yes", style=solid];
"snapshot" -> "new" [label="", style=solid];
"new" -> "skip" [label="No", style=solid];
"new" -> "parse" [label="Yes", style=solid];
"parse" -> "valid" [label="", style=solid];
"valid" -> "rollback" [label="No", style=solid];
"rollback" -> "watch" [label="Correct / change file", style=solid];
"valid" -> "commit" [label="Yes", style=solid];
"commit" -> "dispatch" [label="", style=solid];
"dispatch" -> "health" [label="", style=solid];
}