digraph workflow {
graph [rankdir=TB, bgcolor="#0b1017", pad="0.35", nodesep="0.38", ranksep="0.6", splines=polyline, outputorder=edgesfirst];
node [fontname="DejaVu Sans", fontsize=12, fontcolor="#e6e8ec", shape=box, style="rounded,filled", penwidth=1.1, margin="0.18,0.12"];
edge [fontname="DejaVu Sans", fontsize=10, fontcolor="#c2cbd8", color="#8392a5", arrowsize=0.7, penwidth=1.1];
"trigger" [label="Manual Sync public sources, CLI\nsync-feeds or selected source\nsync", tooltip="Manual Sync public sources, CLI sync-feeds or selected source sync", shape=box, fillcolor="#14202f", color="#7197bd"];
"channels" [label="Independent source paths", tooltip="Independent source paths", shape=diamond, fillcolor="#292419", color="#b39461"];
"checkpoint" [label="NVD saved window / page\ncheckpoint exists?", tooltip="NVD saved window / page checkpoint exists?", shape=diamond, fillcolor="#292419", color="#b39461"];
"resume" [label="Resume saved fixed window at\nnext page; checkpoint takes\nprecedence", tooltip="Resume saved fixed window at next page; checkpoint takes precedence", shape=box, fillcolor="#14202f", color="#7197bd"];
"backfill" [label="Explicit --backfill-days 1\u2013120?", tooltip="Explicit --backfill-days 1\u2013120?", shape=diamond, fillcolor="#292419", color="#b39461"];
"wide" [label="Start requested last-modified\nwindow", tooltip="Start requested last-modified window", shape=box, fillcolor="#14202f", color="#7197bd"];
"incremental" [label="Normal sync: last successful\nwindow with one-day overlap;\nfirst run about one day", tooltip="Normal sync: last successful window with one-day overlap; first run about one day", shape=box, fillcolor="#14202f", color="#7197bd"];
"page" [label="Fetch bounded NVD page; timeout\n/ transient retry handling", tooltip="Fetch bounded NVD page; timeout / transient retry handling", shape=box, fillcolor="#14202f", color="#7197bd"];
"saved" [label="Normalize and persist page +\ncheckpoint", tooltip="Normalize and persist page + checkpoint", shape=cylinder, fillcolor="#17202a", color="#738397"];
"more" [label="More pages?", tooltip="More pages?", shape=diamond, fillcolor="#292419", color="#b39461"];
"finish" [label="Clear checkpoint; store last\nsuccessful synchronization", tooltip="Clear checkpoint; store last successful synchronization", shape=box, fillcolor="#15271f", color="#7eaa90"];
"other" [label="KEV full JSON; ICS RSS;\nconfigured CSAF URLs with\nconditional cache", tooltip="KEV full JSON; ICS RSS; configured CSAF URLs with conditional cache", shape=box, fillcolor="#14202f", color="#7197bd"];
"single" [label="refresh-cve: one official CVE\nrecord", tooltip="refresh-cve: one official CVE record", shape=box, fillcolor="#14202f", color="#7197bd"];
"offline" [label="Load validated offline advisory\nfixture; retain declared\nprovenance", tooltip="Load validated offline advisory fixture; retain declared provenance", shape=cylinder, fillcolor="#17202a", color="#738397"];
"normalize" [label="Deduplicate by source /\nidentifier; preserve versions,\nrefs and retrieved time", tooltip="Deduplicate by source / identifier; preserve versions, refs and retrieved time", shape=cylinder, fillcolor="#17202a", color="#738397"];
"fail" [label="Source unavailable / malformed:\nretain cache and checkpoint;\nother sources continue", tooltip="Source unavailable / malformed: retain cache and checkpoint; other sources continue", shape=box, fillcolor="#2b1c23", color="#bd8591"];
"interrupt" [label="Operator cancels / process\nstops: saved pages and\ncheckpoint persist", tooltip="Operator cancels / process stops: saved pages and checkpoint persist", shape=cylinder, fillcolor="#17202a", color="#738397"];
"reeval" [label="Automatically reevaluate\naffected local findings", tooltip="Automatically reevaluate affected local findings", shape=box, fillcolor="#14202f", color="#7197bd"];
"health" [label="Show source health, recent\nupdates, last success and\nstaleness after 24 hours", tooltip="Show source health, recent updates, last success and staleness after 24 hours", shape=box, fillcolor="#292217", color="#c4a071"];
"trigger" -> "channels" [label="", style=solid];
"channels" -> "checkpoint" [label="NVD", style=solid];
"checkpoint" -> "resume" [label="Yes", style=solid];
"checkpoint" -> "backfill" [label="No", style=solid];
"backfill" -> "wide" [label="Yes", style=solid];
"backfill" -> "incremental" [label="No", style=solid];
"resume" -> "page" [label="", style=solid];
"wide" -> "page" [label="", style=solid];
"incremental" -> "page" [label="", style=solid];
"page" -> "saved" [label="Valid page", style=solid];
"saved" -> "more" [label="", style=solid];
"more" -> "page" [label="Yes", style=solid];
"more" -> "finish" [label="No", style=solid];
"page" -> "fail" [label="Source failure", style=solid];
"page" -> "interrupt" [label="Operator cancellation / process\nstop", style=solid];
"interrupt" -> "trigger" [label="Next operator sync resumes", style=solid];
"channels" -> "other" [label="CISA sources", style=solid];
"other" -> "normalize" [label="Valid / updated", style=solid];
"other" -> "fail" [label="Unavailable", style=solid];
"finish" -> "normalize" [label="", style=solid];
"single" -> "normalize" [label="", style=solid];
"offline" -> "normalize" [label="", style=solid];
"normalize" -> "reeval" [label="", style=solid];
"reeval" -> "health" [label="", style=solid];
"fail" -> "health" [label="", style=solid];
"health" -> "trigger" [label="Operator retries when ready", style=dashed];
}