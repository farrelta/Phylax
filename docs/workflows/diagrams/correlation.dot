digraph workflow {
graph [rankdir=TB, bgcolor="#0b1017", pad="0.35", nodesep="0.38", ranksep="0.6", splines=polyline, outputorder=edgesfirst];
node [fontname="DejaVu Sans", fontsize=12, fontcolor="#e6e8ec", shape=box, style="rounded,filled", penwidth=1.1, margin="0.18,0.12"];
edge [fontname="DejaVu Sans", fontsize=10, fontcolor="#c2cbd8", color="#8392a5", arrowsize=0.7, penwidth=1.1];
"identity" [label="Hardware / firmware inventory\nplus active software components", tooltip="Hardware / firmware inventory plus active software components", shape=cylinder, fillcolor="#17202a", color="#738397"];
"component" [label="Software observation: raw name,\nversion, source and time", tooltip="Software observation: raw name, version, source and time", shape=cylinder, fillcolor="#17202a", color="#738397"];
"mapping" [label="Exact operator-managed product\nmapping exists?", tooltip="Exact operator-managed product mapping exists?", shape=diamond, fillcolor="#292419", color="#b39461"];
"unmapped" [label="Retain unmapped component for\noperator mapping / review", tooltip="Retain unmapped component for operator mapping / review", shape=box, fillcolor="#292217", color="#c4a071"];
"mapped" [label="Normalize vendor/product;\nretain raw values and\nverification state", tooltip="Normalize vendor/product; retain raw values and verification state", shape=cylinder, fillcolor="#17202a", color="#738397"];
"changed" [label="Different / competing observed\nversion?", tooltip="Different / competing observed version?", shape=diamond, fillcolor="#292419", color="#b39461"];
"reset" [label="Invalidate prior component\nverification; record changes;\nconflicting active versions\nneed review", tooltip="Invalidate prior component verification; record changes; conflicting active versions need review", shape=box, fillcolor="#292217", color="#c4a071"];
"candidates" [label="Exact normalized vendor/product\ncandidates", tooltip="Exact normalized vendor/product candidates", shape=box, fillcolor="#14202f", color="#7197bd"];
"candidate" [label="Any candidate?", tooltip="Any candidate?", shape=diamond, fillcolor="#292419", color="#b39461"];
"none" [label="No applicability finding for\nunrelated products; missing\nidentity stays reviewable", tooltip="No applicability finding for unrelated products; missing identity stays reviewable", shape=box, fillcolor="#292217", color="#c4a071"];
"conditions" [label="Identity confidence sufficient;\nprerequisites supported and\nsources consistent?", tooltip="Identity confidence sufficient; prerequisites supported and sources consistent?", shape=diamond, fillcolor="#292419", color="#b39461"];
"review" [label="NEEDS_REVIEW", tooltip="NEEDS_REVIEW", shape=box, fillcolor="#292217", color="#c4a071"];
"version" [label="Installed version known?", tooltip="Installed version known?", shape=diamond, fillcolor="#292419", color="#b39461"];
"semantics" [label="Can source version conditions\nbe compared safely?", tooltip="Can source version conditions be compared safely?", shape=diamond, fillcolor="#292419", color="#b39461"];
"verify_match" [label="Verified high-confidence\nidentity?", tooltip="Verified high-confidence identity?", shape=diamond, fillcolor="#292419", color="#b39461"];
"verify_exclusion" [label="Verified high-confidence\nidentity?", tooltip="Verified high-confidence identity?", shape=diamond, fillcolor="#292419", color="#b39461"];
"potential" [label="POTENTIAL_MATCH", tooltip="POTENTIAL_MATCH", shape=box, fillcolor="#292217", color="#c4a071"];
"affected" [label="Source-defined version\naffected?", tooltip="Source-defined version affected?", shape=diamond, fillcolor="#292419", color="#b39461"];
"confirmed" [label="CONFIRMED_MATCH", tooltip="CONFIRMED_MATCH", shape=box, fillcolor="#15271f", color="#7eaa90"];
"excluded" [label="NO_MATCH_TO_THIS_ADVISORY", tooltip="NO_MATCH_TO_THIS_ADVISORY", shape=cylinder, fillcolor="#17202a", color="#738397"];
"aggregate" [label="One stable asset/CVE finding\nwith component evidence;\nconfirmed \u2192 potential \u2192 review\n\u2192 exclusion", tooltip="One stable asset/CVE finding with component evidence; confirmed \u2192 potential \u2192 review \u2192 exclusion", shape=cylinder, fillcolor="#17202a", color="#738397"];
"priority" [label="Vulnerability urgency rule v2;\nscore only confirmed /\npotential", tooltip="Vulnerability urgency rule v2; score only confirmed / potential", shape=box, fillcolor="#14202f", color="#7197bd"];
"alert" [label="Create/update deduplicated\nexposure alert; preserve\nacknowledgement on update", tooltip="Create/update deduplicated exposure alert; preserve acknowledgement on update", shape=box, fillcolor="#15271f", color="#7eaa90"];
"noalert" [label="No active exposure alert for\nreview / excluded; retain\nassessment evidence", tooltip="No active exposure alert for review / excluded; retain assessment evidence", shape=cylinder, fillcolor="#17202a", color="#738397"];
"planchange" [label="Changed supporting finding\nevidence / priority: archive\nplan and require more evidence", tooltip="Changed supporting finding evidence / priority: archive plan and require more evidence", shape=box, fillcolor="#292217", color="#c4a071"];
"recheck" [label="Inventory, mapping, component\nreview or source change\nretriggers assessment", tooltip="Inventory, mapping, component review or source change retriggers assessment", shape=box, fillcolor="#14202f", color="#7197bd"];
"component" -> "mapping" [label="", style=solid];
"mapping" -> "unmapped" [label="No", style=solid];
"unmapped" -> "mapping" [label="Operator adds mapping", style=solid];
"mapping" -> "mapped" [label="Yes", style=solid];
"mapped" -> "changed" [label="", style=solid];
"changed" -> "reset" [label="Yes", style=solid];
"changed" -> "identity" [label="No", style=solid];
"reset" -> "identity" [label="", style=solid];
"identity" -> "candidates" [label="", style=solid];
"candidates" -> "candidate" [label="", style=solid];
"candidate" -> "none" [label="No", style=solid];
"candidate" -> "conditions" [label="Yes", style=solid];
"conditions" -> "review" [label="No / conflict", style=solid];
"conditions" -> "version" [label="Yes", style=solid];
"version" -> "potential" [label="No", style=solid];
"version" -> "semantics" [label="Yes", style=solid];
"semantics" -> "review" [label="No", style=solid];
"semantics" -> "affected" [label="Yes", style=solid];
"affected" -> "verify_match" [label="Affected", style=solid];
"affected" -> "verify_exclusion" [label="Outside / explicitly fixed", style=solid];
"verify_match" -> "confirmed" [label="Yes", style=solid];
"verify_match" -> "potential" [label="No", style=solid];
"verify_exclusion" -> "excluded" [label="Yes", style=solid];
"verify_exclusion" -> "review" [label="No", style=solid];
"review" -> "aggregate" [label="", style=solid];
"potential" -> "aggregate" [label="", style=solid];
"confirmed" -> "aggregate" [label="", style=solid];
"excluded" -> "aggregate" [label="", style=solid];
"aggregate" -> "priority" [label="", style=solid];
"priority" -> "alert" [label="Confirmed / potential", style=solid];
"priority" -> "noalert" [label="Review / excluded", style=solid];
"aggregate" -> "planchange" [label="Supporting evidence changed", style=solid];
"recheck" -> "identity" [label="", style=solid];
"none" -> "recheck" [label="Operator supplies evidence", style=dashed];
}