digraph workflow {
graph [rankdir=TB, bgcolor="#0b1017", pad="0.35", nodesep="0.38", ranksep="0.6", splines=polyline, outputorder=edgesfirst];
node [fontname="DejaVu Sans", fontsize=12, fontcolor="#e6e8ec", shape=box, style="rounded,filled", penwidth=1.1, margin="0.18,0.12"];
edge [fontname="DejaVu Sans", fontsize=10, fontcolor="#c2cbd8", color="#8392a5", arrowsize=0.7, penwidth=1.1];
"choose" [label="Choose known supporting IT\nasset / management IP", tooltip="Choose known supporting IT asset / management IP", shape=box, fillcolor="#292217", color="#c4a071"];
"eligible" [label="Known eligible inventory and\nliteral IPv4 target?", tooltip="Known eligible inventory and literal IPv4 target?", shape=diamond, fillcolor="#292419", color="#b39461"];
"reject" [label="Reject OT control endpoints,\nunknown / observed-only\nidentities and ineligible\ntargets", tooltip="Reject OT control endpoints, unknown / observed-only identities and ineligible targets", shape=box, fillcolor="#2b1c23", color="#bd8591"];
"permission" [label="Save separate scan permission,\n1\u201332 TCP ports, optional\nstandard HTTP(S)/SSH\nidentification", tooltip="Save separate scan permission, 1\u201332 TCP ports, optional standard HTTP(S)/SSH identification", shape=box, fillcolor="#14202f", color="#7197bd"];
"trigger" [label="Manual request or enabled\nschedule due?", tooltip="Manual request or enabled schedule due?", shape=diamond, fillcolor="#292419", color="#b39461"];
"queue" [label="Deduplicated persistent queued\nrun bound to permission\nrevision", tooltip="Deduplicated persistent queued run bound to permission revision", shape=cylinder, fillcolor="#17202a", color="#738397"];
"worker" [label="Separate worker claims\ndatabase-wide lease", tooltip="Separate worker claims database-wide lease", shape=box, fillcolor="#14202f", color="#7197bd"];
"lease" [label="Another valid lease active?", tooltip="Another valid lease active?", shape=diamond, fillcolor="#292419", color="#b39461"];
"busy" [label="Busy; do not overlap workers", tooltip="Busy; do not overlap workers", shape=cylinder, fillcolor="#17202a", color="#738397"];
"recover" [label="Expired running work becomes\nInterrupted; no automatic\nreplay", tooltip="Expired running work becomes Interrupted; no automatic replay", shape=box, fillcolor="#292217", color="#c4a071"];
"check" [label="Revalidate permission,\neligibility, revision and\ncancellation", tooltip="Revalidate permission, eligibility, revision and cancellation", shape=diamond, fillcolor="#292419", color="#b39461"];
"cancel" [label="Cancelled: operator request or\nchanged / revoked target", tooltip="Cancelled: operator request or changed / revoked target", shape=box, fillcolor="#2b1c23", color="#bd8591"];
"nmap" [label="Bounded unprivileged TCP\nconnect scan; no DNS / extra\ndiscovery probes", tooltip="Bounded unprivileged TCP connect scan; no DNS / extra discovery probes", shape=box, fillcolor="#14202f", color="#7197bd"];
"ok" [label="Probe succeeds within limits?", tooltip="Probe succeeds within limits?", shape=diamond, fillcolor="#292419", color="#b39461"];
"failed" [label="Failed: missing Nmap, timeout\nor execution error", tooltip="Failed: missing Nmap, timeout or execution error", shape=box, fillcolor="#2b1c23", color="#bd8591"];
"identify" [label="Only selected open ports:\noptional HTTP(S) headers or SSH\nbanner", tooltip="Only selected open ports: optional HTTP(S) headers or SSH banner", shape=box, fillcolor="#14202f", color="#7197bd"];
"finalcheck" [label="Permission, revision and\ncancellation still valid before\npersistence?", tooltip="Permission, revision and cancellation still valid before persistence?", shape=diamond, fillcolor="#292419", color="#b39461"];
"result" [label="Store port states, tool\nversion, provenance and\nidentification errors", tooltip="Store port states, tool version, provenance and identification errors", shape=cylinder, fillcolor="#17202a", color="#738397"];
"observe" [label="Active-probe evidence and\nservice changes; versions\nremain unverified", tooltip="Active-probe evidence and service changes; versions remain unverified", shape=cylinder, fillcolor="#17202a", color="#738397"];
"software" [label="Known component evidence \u2192\nsoftware review and correlation", tooltip="Known component evidence \u2192 software review and correlation", shape=box, fillcolor="#15271f", color="#7eaa90"];
"schedule" [label="Next schedule after interval;\nmissed intervals skipped", tooltip="Next schedule after interval; missed intervals skipped", shape=box, fillcolor="#14202f", color="#7197bd"];
"choose" -> "eligible" [label="", style=solid];
"eligible" -> "reject" [label="No", style=solid];
"eligible" -> "permission" [label="Yes", style=solid];
"permission" -> "trigger" [label="", style=solid];
"trigger" -> "queue" [label="Run / schedule", style=solid];
"queue" -> "worker" [label="", style=solid];
"worker" -> "lease" [label="", style=solid];
"lease" -> "busy" [label="Yes", style=solid];
"lease" -> "recover" [label="No / expired", style=solid];
"recover" -> "check" [label="", style=solid];
"check" -> "cancel" [label="No longer valid", style=solid];
"check" -> "nmap" [label="Valid", style=solid];
"nmap" -> "ok" [label="", style=solid];
"ok" -> "failed" [label="No", style=solid];
"ok" -> "identify" [label="Yes", style=solid];
"identify" -> "finalcheck" [label="", style=solid];
"finalcheck" -> "cancel" [label="No", style=solid];
"finalcheck" -> "result" [label="Yes", style=solid];
"result" -> "observe" [label="", style=solid];
"observe" -> "software" [label="", style=solid];
"software" -> "schedule" [label="", style=solid];
"failed" -> "schedule" [label="", style=solid];
"cancel" -> "schedule" [label="", style=solid];
"schedule" -> "trigger" [label="", style=solid];
"permission" -> "cancel" [label="Changing permission invalidates\nqueued work", style=dashed];
}