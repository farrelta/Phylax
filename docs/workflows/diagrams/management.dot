digraph workflow {
graph [rankdir=TB, bgcolor="#0b1017", pad="0.35", nodesep="0.38", ranksep="0.6", splines=polyline, outputorder=edgesfirst];
node [fontname="DejaVu Sans", fontsize=12, fontcolor="#e6e8ec", shape=box, style="rounded,filled", penwidth=1.1, margin="0.18,0.12"];
edge [fontname="DejaVu Sans", fontsize=10, fontcolor="#c2cbd8", color="#8392a5", arrowsize=0.7, penwidth=1.1];
"obs" [label="Connection / DHCP / software /\nactive-probe observation", tooltip="Connection / DHCP / software / active-probe observation", shape=cylinder, fillcolor="#17202a", color="#738397"];
"changes" [label="Record first sighting,\nservices, software and IP/MAC\nchanges", tooltip="Record first sighting, services, software and IP/MAC changes", shape=cylinder, fillcolor="#17202a", color="#738397"];
"dhcp" [label="DHCP association evidence?", tooltip="DHCP association evidence?", shape=diamond, fillcolor="#292419", color="#b39461"];
"assigned" [label="Assigned/client-address\nevidence can support a MAC\nassociation", tooltip="Assigned/client-address evidence can support a MAC association", shape=cylinder, fillcolor="#17202a", color="#738397"];
"requested" [label="Requested address alone does\nnot establish an assigned\nidentity", tooltip="Requested address alone does not establish an assigned identity", shape=box, fillcolor="#292217", color="#c4a071"];
"subnet" [label="Endpoint in a configured\nmonitored subnet?", tooltip="Endpoint in a configured monitored subnet?", shape=diamond, fillcolor="#292419", color="#b39461"];
"unmonitored" [label="Unmonitored; no\nunmanaged-device alert", tooltip="Unmonitored; no unmanaged-device alert", shape=cylinder, fillcolor="#17202a", color="#738397"];
"compare" [label="Compare explicit IP / MAC /\npair decisions and verified\nidentity", tooltip="Compare explicit IP / MAC / pair decisions and verified identity", shape=box, fillcolor="#14202f", color="#7197bd"];
"status" [label="Resulting management state", tooltip="Resulting management state", shape=diamond, fillcolor="#292419", color="#b39461"];
"approved" [label="Approved; resolve related\nendpoint alert and retain\nhistory", tooltip="Approved; resolve related endpoint alert and retain history", shape=box, fillcolor="#15271f", color="#7eaa90"];
"blocked" [label="Explicitly blocked \u2192\nUnauthorized", tooltip="Explicitly blocked \u2192 Unauthorized", shape=box, fillcolor="#2b1c23", color="#bd8591"];
"unmanaged" [label="No applicable approval \u2192\nUnmanaged \u2014 needs review", tooltip="No applicable approval \u2192 Unmanaged \u2014 needs review", shape=box, fillcolor="#292217", color="#c4a071"];
"ambiguous" [label="Missing MAC-bound proof or\nconflicting identity \u2192 Identity\nreview", tooltip="Missing MAC-bound proof or conflicting identity \u2192 Identity review", shape=box, fillcolor="#292217", color="#c4a071"];
"alert" [label="One deduplicated endpoint alert\nper monitored subnet / IP", tooltip="One deduplicated endpoint alert per monitored subnet / IP", shape=cylinder, fillcolor="#17202a", color="#738397"];
"operator" [label="Operator reviews original\nevidence and records approve /\nblock / revoke", tooltip="Operator reviews original evidence and records approve / block / revoke", shape=box, fillcolor="#292217", color="#c4a071"];
"repeat" [label="Reevaluate stored evidence;\nreactivated endpoint alert\nresets acknowledgement", tooltip="Reevaluate stored evidence; reactivated endpoint alert resets acknowledgement", shape=box, fillcolor="#14202f", color="#7197bd"];
"separate" [label="Approval / acknowledgement\nnever grants scan permission", tooltip="Approval / acknowledgement never grants scan permission", shape=box, fillcolor="#15271f", color="#7eaa90"];
"obs" -> "changes" [label="", style=solid];
"changes" -> "dhcp" [label="", style=solid];
"dhcp" -> "assigned" [label="Assigned evidence", style=solid];
"dhcp" -> "requested" [label="Request only", style=solid];
"dhcp" -> "subnet" [label="Other observation", style=solid];
"assigned" -> "subnet" [label="", style=solid];
"requested" -> "subnet" [label="", style=solid];
"subnet" -> "unmonitored" [label="No", style=solid];
"subnet" -> "compare" [label="Yes", style=solid];
"compare" -> "status" [label="", style=solid];
"status" -> "approved" [label="Approved", style=solid];
"status" -> "blocked" [label="Blocked", style=solid];
"status" -> "unmanaged" [label="Unapproved", style=solid];
"status" -> "ambiguous" [label="Insufficient / conflicting", style=solid];
"blocked" -> "alert" [label="", style=solid];
"unmanaged" -> "alert" [label="", style=solid];
"ambiguous" -> "alert" [label="", style=solid];
"alert" -> "operator" [label="", style=solid];
"operator" -> "repeat" [label="", style=solid];
"repeat" -> "compare" [label="", style=solid];
"approved" -> "separate" [label="", style=solid];
}