# Optional NVD API key for higher-rate feed synchronization.
# NVD_API_KEY=

# Optional hosted remediation provider. AI remains disabled until configured.
# Built-ins: gemini, groq, openrouter. Use custom for another OpenAI-compatible API.
# PHYLAX_AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-key
# PHYLAX_AI_MODEL=openrouter/free
#
# Gemini:
# PHYLAX_AI_PROVIDER=gemini
# GEMINI_API_KEY=your-key
# PHYLAX_AI_MODEL=your-enabled-gemini-model
# PHYLAX_AI_TIMEOUT_SECONDS=90
#
# Groq:
# PHYLAX_AI_PROVIDER=groq
# GROQ_API_KEY=your-key
# PHYLAX_AI_MODEL=your-active-groq-model
#
# Custom OpenAI-compatible endpoint:
# PHYLAX_AI_PROVIDER=custom
# PHYLAX_AI_BASE_URL=https://api.example/v1
# PHYLAX_AI_MODEL=your-model-name
# PHYLAX_AI_API_KEY=your-secret
